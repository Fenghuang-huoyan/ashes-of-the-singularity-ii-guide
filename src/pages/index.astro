---
import { getCollection } from 'astro:content';
import BaseLayout from '@framework/layouts/BaseLayout.astro';
import QuickAnswer from '@framework/components/QuickAnswer.astro';
import AdSlot from '@framework/components/AdSlot.astro';
import FaqList from '@framework/components/FaqList.astro';
import { loadData } from '@framework/lib/content';
import { siteConfig } from '@site/site.config';
import { faqJsonLd, websiteJsonLd } from '@framework/lib/seo';

const meta = loadData<{
  release: string;
  price: string;
  priceNote: string;
  players: string;
  playersNote: string;
  reviews: string;
  reviewsNote: string;
  modes: string;
  modesNote: string;
  platforms: string;
}>('meta');

const faq = loadData<{ q: string; a: string; featured?: boolean }[]>('faq');
const pages = (await getCollection('pages')).sort((a, b) => a.data.order - b.data.order);

const art = {
  header: '/images/official/steam/header.jpg',
  hero: '/images/official/steam/library-hero.jpg',
  hero2x: '/images/official/steam/library-hero-2x.jpg',
  capsule: '/images/official/steam/capsule-616x353.jpg',
  lava: '/images/official/steam/ss-00.jpg',
  cliff: '/images/official/steam/ss-01.jpg',
  regions: '/images/official/steam/ss-02.jpg',
  snow: '/images/official/steam/ss-04.jpg',
  zoom: '/images/official/steam/ss-05.jpg',
  desert: '/images/official/steam/ss-06.jpg',
};

const guideArt: Record<string, string> = {
  guide: art.regions,
  factions: art.capsule,
  about: art.hero,
};

const doors = [
  {
    href: '/guide',
    num: '01',
    title: 'Guide',
    text: 'Armies, regions, Turinium, Elerite, and the counters Stardock has actually described. Not a build order.',
    image: art.regions,
  },
  {
    href: '/factions',
    num: '02',
    title: 'Factions',
    text: 'United Earth Forces, Post-Human Coalition, and AI Substrate. Named units only where an official post named them.',
    image: art.capsule,
  },
  {
    href: '/about',
    num: '03',
    title: 'About',
    text: 'Unofficial fan site. Disclaimer, privacy, and the Steam art credits.',
    image: art.header,
  },
];

const stills = [
  { src: art.lava, caption: 'Lava battlefield' },
  { src: art.cliff, caption: 'Cliff battle' },
  { src: art.regions, caption: 'Region map' },
  { src: art.snow, caption: 'Snow pass' },
  { src: art.zoom, caption: 'Strategic zoom' },
  { src: art.desert, caption: 'Desert fight' },
];
---
<BaseLayout
  title={siteConfig.homeTitle}
  description={siteConfig.homeDescription}
  jsonLd={[
    websiteJsonLd(),
    faqJsonLd(faq.filter((item) => item.featured).map((item) => ({ q: item.q, a: item.a }))),
  ]}
>
  <main id="content">
    <div class="shell">
      <p class="tape">
        <span>Fan guide · not affiliated with Oxide Games or Stardock</span>
        <span>Steam App {siteConfig.steamAppId}</span>
        <span>{siteConfig.version.label}</span>
      </p>

      <section class="town-hero">
        <img
          class="hero-art"
          src={siteConfig.art.hero}
          srcset={`${art.hero} 1920w, ${art.hero2x} 3840w`}
          sizes="(min-width: 1536px) 1536px, 100vw"
          alt={siteConfig.art.heroAlt}
          width="1920"
          height="620"
          fetchpriority="high"
          decoding="async"
        />
        <div class="hero-panel">
          <p class="kicker">{siteConfig.developer} · {siteConfig.publisher} · releases {meta.release}</p>
          <h1>A field manual for Ashes of the Singularity II.</h1>
          <p class="lede">
            English pages for the large-scale RTS: three factions, regions and Turinium, and the counters official posts describe.
            The game is not on a live client yet. Where a number was never printed, the page says so.
          </p>
          <div class="cta-row">
            <a class="btn" href="/guide">Guide</a>
            <a class="btn ghost" href="/factions">Factions</a>
            <a class="btn ghost" href={siteConfig.steamUrl}>View on Steam</a>
          </div>
          <p class="version-note">{siteConfig.version.detail}</p>
        </div>
      </section>
      <p class="art-credit">
        Library hero, capsules, header, and screenshots are official Steam store assets for App {siteConfig.steamAppId}, saved from the store CDN.
        Credits and source URLs: <a href="/images/official/steam/ATTRIBUTION.txt">ATTRIBUTION.txt</a>.
      </p>

      <section class="section">
        <h2>Three doors</h2>
        <p class="section-intro">
          Open the strategy overview, the faction pages, or the disclaimer. There is no codes page. The sources checked do not list a redeem program.
        </p>
        <div class="door-grid">
          {doors.map((door) => (
            <a class="door" href={door.href}>
              <span class="card-art">
                <img src={door.image} alt="" width="600" height="338" decoding="async" />
                <span class="num">{door.num}</span>
              </span>
              <span class="card-copy">
                <h3>{door.title}</h3>
                <p>{door.text}</p>
              </span>
            </a>
          ))}
        </div>
      </section>

      <section class="section" aria-label="Official Steam screenshots">
        <h2>The store’s own frames</h2>
        <p class="section-intro">
          Six screenshots from the Steam page: a lava field, a cliff fight, a region map, snow, a zoomed-out command view, and a desert battle. They are not a unit catalog.
        </p>
        <div class="still-row">
          {stills.map((still) => (
            <figure>
              <img src={still.src} alt="" width="600" height="338" loading="lazy" decoding="async" />
              <figcaption>{still.caption}</figcaption>
            </figure>
          ))}
        </div>
      </section>

      <section class="stat-row" aria-label="Steam figures">
        <div class="stat"><strong>{meta.price}</strong><span>{meta.priceNote}</span></div>
        <div class="stat"><strong>{meta.reviews}</strong><span>{meta.reviewsNote}</span></div>
        <div class="stat"><strong>{meta.players}</strong><span>{meta.playersNote}</span></div>
        <div class="stat"><strong>{meta.modes}</strong><span>{meta.modesNote}</span></div>
      </section>

      <section class="section home-quick">
        <QuickAnswer
          sentences={[
            'Ashes of the Singularity II is a real-time strategy game from Oxide Games, published by Stardock Entertainment, on Steam (AppID 3499790). The store date is 10 November 2026. On 6 November 2026 the appdetails payload still marked it coming soon, Windows only, and not free.',
            'The short description says you command the forces of Earth, the mechanical AI Substrate, or the Post-Human Coalition across single player, cooperative multiplayer, or competitive multiplayer. Steam also names Campaign, Instant Action, and Strategic Zoom.',
            'Turinium is the resource the factions fight over: the 6 August 2025 welcome journal calls it the currency of intelligence, and the store says terrain turns to or from Turinium. Income rates are not printed on those pages.',
            'There is no redeem-code list. Pre-release unit cards, where an official post printed health or damage, are labeled with that post’s date and are not treated as launch balance.',
          ]}
        />
        <AdSlot name="afterQuickAnswer" />
      </section>

      <section class="section">
        <h2>The pages</h2>
        <p class="section-intro">
          English only. A line from the Steam page or a Stardock post is labeled with its date. A missing stat stays missing.
        </p>
        <div class="card-grid">
          {pages.map((page) => (
            <a class="guide-card" href={`/${page.id}`}>
              <span class="card-art">
                <img src={guideArt[page.id] ?? art.header} alt="" width="600" height="338" loading="lazy" decoding="async" />
              </span>
              <span class="card-copy">
                <span class="section-tag">{page.data.section}</span>
                <h3>{page.data.h1}</h3>
                <p>{page.data.description}</p>
              </span>
            </a>
          ))}
        </div>
      </section>

      <section class="section">
        <div class="scope">
          <div>
            <h2>What this wiki is for</h2>
            <p>
              The store page and the official posts live at {siteConfig.databases.map((db, i) => (
                <>
                  <a href={db.href}>{db.label}</a>
                  {i < siteConfig.databases.length - 1 ? ', ' : ''}
                </>
              ))}. This site is the skim: factions, resources, and the counters those sources actually describe.
            </p>
            <p>
              The game unlocks on {meta.release}. If a launch patch and this page disagree, trust the client.
            </p>
          </div>
          <div>
            <h2>In Steam’s words</h2>
            <p>
              {siteConfig.developer} is the developer and {siteConfig.publisher} is the publisher. Platforms on the API: {meta.platforms}. Genres: Simulation and Strategy. The support URL on the store page is https://support.stardock.com/. A Stardock account is listed as optional and can link to Steam.
            </p>
          </div>
        </div>
      </section>

      <section class="section home-faq">
        <h2>Short answers</h2>
        <FaqList featuredOnly />
      </section>
    </div>
  </main>
</BaseLayout>
